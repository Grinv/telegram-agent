{
  "name": "telegram-llm-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Telegram bot that forwards messages to a pluggable LLM connector (Ollama, currently stubbed).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc && cp src/stats/schema.sql dist/stats/schema.sql && cp src/history/schema.sql dist/history/schema.sql && node scripts/write-dist-package-json.mjs",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "sandbox:build": "docker build --pull -t telegram-agent-sandbox ./sandbox",
    "docker:up": "node scripts/check-sandbox-image.mjs && docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker image prune -f && docker builder prune -f",
    "isolated:provision": "node scripts/isolation.mjs provision",
    "isolated:broker": "node scripts/telegram-broker.mjs",
    "isolated:start": "node scripts/isolation.mjs start",
    "isolated:stop": "node scripts/isolation.mjs stop",
    "isolated:status": "node scripts/isolation.mjs status",
    "isolated:destroy": "node scripts/isolation.mjs destroy",
    "stats:report": "node --import tsx src/stats/reporter-cli.ts",
    "stats:summary": "node --import tsx src/stats/summary-cli.ts",
    "stats:timeline": "node --import tsx src/stats/timeline-cli.ts",
    "stats:analysis": "node --import tsx src/stats/analysis-cli.ts",
    "benchmark:run": "node --import tsx benchmark/run.ts",
    "benchmark:compare": "node --import tsx benchmark/compare-cli.ts",
    "benchmark:docker:build": "docker compose build benchmark",
    "benchmark:docker:run": "docker compose run --rm benchmark node --import tsx benchmark/run.ts",
    "typecheck": "tsc --noEmit && tsc -p benchmark/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "undici": "^8.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
