# Telegram bot token from @BotFather. Required.
# In the regular Docker deployment, the bot itself reads this. In the
# isolated (microVM) deployment, it's the host-side broker
# (scripts/telegram-broker.mjs) that reads it from this file - the bot
# inside the boundary only ever sees a non-secret placeholder. See
# DEPLOYMENT.md's isolated-deployment section.
TELEGRAM_BOT_TOKEN=

# Base URL for the Telegram Bot API. Defaults to https://api.telegram.org.
# In the isolated (microVM) deployment this is pointed at the host-side
# broker instead (http://host.docker.internal:<TELEGRAM_BROKER_PORT>), which
# holds the real token and forwards allowed methods on to Telegram - see
# DEPLOYMENT.md. Not used by the regular Docker deployment.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Port the Telegram broker (isolated deployment only) listens on, bound to
# 127.0.0.1. Irrelevant to the regular Docker deployment.
TELEGRAM_BROKER_PORT=8081

# Which LLM connector to use. One of: stub, ollama. Defaults to "ollama"
# (requires Ollama running locally - see OLLAMA_BASE_URL/OLLAMA_MODEL below).
# Startup fails fast if this is set to anything else.
LLM_PROVIDER=ollama

# Max time (ms) to wait for an inference call before killing it and failing. Defaults to 15000.
LLM_TIMEOUT_MS=15000

# Only used by the ollama connector. Ollama must be running with this model
# already pulled (e.g. `ollama pull qwen2.5`), or every message will fail.
# Defaults to the Docker network hostname (see docker-compose.yml). For local
# non-Docker development, set this to http://127.0.0.1:11434 instead.
OLLAMA_BASE_URL=http://ollama:11434
# Must be a tool-calling-capable model (e.g. qwen2.5, llama3.1, mistral-nemo).
# The default "llama3" does NOT support tool calling.
OLLAMA_MODEL=qwen2.5

# Docker image used for the ephemeral tool-execution sandbox. Build it with
# `npm run sandbox:build`.
SANDBOX_IMAGE=telegram-agent-sandbox

# Max lifetime (ms) of a sandbox container before it is force-stopped.
SANDBOX_TIMEOUT_MS=30000

# Memory limit passed to `docker run --memory` for each sandbox container.
SANDBOX_MEMORY_LIMIT=256m

# CPU limit passed to `docker run --cpus` for each sandbox container.
SANDBOX_CPU_LIMIT=0.5

# Sandbox network mode: "isolated" (default) gives sandbox containers no
# network access at all, matching the original behaviour exactly. "egress"
# attaches sandboxes to a dedicated network (see SANDBOX_NETWORK_NAME below)
# so tools can reach the public internet, while the agent's own containers
# and the Docker socket remain unreachable. Switching to "egress" requires
# rebuilding the sandbox image (`npm run sandbox:build`) first, or the image
# has network access but no HTTP client to use it. See README.md for what
# egress mode does and does not protect against.
SANDBOX_NETWORK=isolated

# Name of the dedicated Docker network sandboxes are attached to in egress
# mode. Created automatically on first use if it does not already exist.
# Irrelevant in isolated mode.
SANDBOX_NETWORK_NAME=telegram-agent-sandbox-net

# Max think -> act -> observe iterations per message before giving up.
TOOL_USE_MAX_ITERATIONS=5

# Enables recording per-message/LLM-call/tool-call stats to a local SQLite
# database (data/stats.db, gitignored). Set to "false" to disable entirely.
STATS_ENABLED=true

# Path to the stats SQLite database.
STATS_DB_PATH=data/stats.db

# Whether prompt/reply text is stored alongside stats (useful for debugging,
# but is user-provided text). Set to "false" for privacy-sensitive deployments.
STATS_STORE_PROMPTS=true

# Path to a JSON file mapping model name to price per million tokens
# (`{ "model-name": { "inputPerMillion": N, "outputPerMillion": N }, ... }`),
# used to compute each LLM call's estimated cost. A missing file means every
# model is recorded as unpriced (cost 0, distinguishable from a genuinely
# free call - see README.md's Statistics section). With a local provider
# like Ollama there is no real spend: populate this file with the prices of
# comparable hosted models so the cost figures are a useful proxy for
# relative spend, not an actual bill.
PRICE_TABLE_PATH=prices.json

# Model routing: at startup, models available in Ollama (OLLAMA_BASE_URL) are
# discovered and each message is classified to pick which model handles it.
# Routing is skipped automatically when fewer than 2 models are discovered.

# Model used to classify each message. Must be pulled in Ollama
# (`ollama pull qwen3:1.7b`). Defaults to qwen3:1.7b - a small, text-only
# (non-multimodal) model that's a good speed/accuracy trade-off for routing.
# Classifier calls always run with thinking mode off (`think: false`), since
# the response is parsed as a bare model name. Leave empty to instead
# auto-select the smallest discovered model.
CLASSIFIER_MODEL=qwen3:1.7b

# Max time (ms) to wait for the classifier before falling back to
# ROUTER_FALLBACK_MODEL. Defaults to 5000 (shorter than LLM_TIMEOUT_MS, since
# a slow classification should just fall back rather than delay the reply).
CLASSIFIER_TIMEOUT_MS=5000

# Model used when the classifier times out, errors, or returns an
# unrecognized name. Empty (default) auto-selects the largest discovered
# model that supports tool calling (or the largest overall, if none do).
ROUTER_FALLBACK_MODEL=

# Parallel subagents: the LLM can call spawn_subagent/spawn_subagents to run
# independent think -> act -> observe loops concurrently, each with its own
# sandbox. Sub-agents cannot spawn further sub-agents (recursion guard).

# Max number of sub-agent loops spawn_subagents runs concurrently; extra
# tasks are processed in batches of this size.
MAX_SUBAGENTS=3

# Max think -> act -> observe iterations for a single sub-agent's own loop
# (kept lower than TOOL_USE_MAX_ITERATIONS to bound sub-agent runtime).
MAX_SUB_ITERATIONS=3

# OTLP endpoint traces are exported to (e.g. http://localhost:4318, a
# collector's HTTP receiver - "/v1/traces" is appended automatically). Unset
# by default: with no endpoint, nothing is exported, no OTel SDK is started,
# and no data of any kind leaves this machine. Setting it exports the same
# measurements recorded locally (model, tokens, latency, cost, tool calls,
# etc.) as OpenTelemetry traces, in addition to - not instead of - the local
# database. See README.md's Statistics section.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Context management: bounds on what enters a request to the model. See
# README.md's "Context management" section for the full picture.

# Max size (characters) a tool result may reach before it is truncated. A
# truncated result keeps the beginning and, where there's room, the end, and
# states that it was truncated and how large the original was.
TOOL_RESULT_MAX_BYTES=8000

# Estimated-token size above which a chat's stored conversation is sent
# compacted (recent turns intact, a summary produced by its own LLM call in
# place of earlier ones) rather than in full. The stored conversation itself
# is never affected - only /new clears it. The default is set far above any
# conversation length observed in the benchmark or real usage (see
# openspec/changes/add-token-optimizations/notes.md, section 4.7), so
# compaction only engages on a genuinely long-running chat.
CONVERSATION_COMPACTION_THRESHOLD=4000

# Directory containing authored skill Markdown files (loaded at startup).
# Skills advertise their names and descriptions to the model on every message,
# and the model can request the full body of a skill via the read_skill tool.
# Changing skills requires restarting the bot for the new files to be loaded.
# Defaults to "skills" (a directory in the repo root).
SKILLS_DIR=skills
