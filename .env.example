# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Which LLM connector to use. One of: stub, ollama. Defaults to "ollama"
# (requires Ollama running locally - see OLLAMA_BASE_URL/OLLAMA_MODEL below).
# Startup fails fast if this is set to anything else.
LLM_PROVIDER=ollama

# Max time (ms) to wait for an inference call before killing it and failing. Defaults to 15000.
LLM_TIMEOUT_MS=15000

# Only used by the ollama connector. Ollama must be running locally with this
# model already pulled (e.g. `ollama pull llama3`), or every message will fail.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
