# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Which LLM connector to use. One of: stub, ollama. Defaults to "ollama"
# (requires Ollama running locally - see OLLAMA_BASE_URL/OLLAMA_MODEL below).
# Startup fails fast if this is set to anything else.
LLM_PROVIDER=ollama

# Max time (ms) to wait for an inference call before killing it and failing. Defaults to 15000.
LLM_TIMEOUT_MS=15000

# Only used by the ollama connector. Ollama must be running with this model
# already pulled (e.g. `ollama pull qwen2.5`), or every message will fail.
# Defaults to the Docker network hostname (see docker-compose.yml). For local
# non-Docker development, set this to http://127.0.0.1:11434 instead.
OLLAMA_BASE_URL=http://ollama:11434
# Must be a tool-calling-capable model (e.g. qwen2.5, llama3.1, mistral-nemo).
# The default "llama3" does NOT support tool calling.
OLLAMA_MODEL=qwen2.5

# Docker image used for the ephemeral tool-execution sandbox. Build it with
# `npm run sandbox:build`.
SANDBOX_IMAGE=telegram-agent-sandbox

# Max lifetime (ms) of a sandbox container before it is force-stopped.
SANDBOX_TIMEOUT_MS=30000

# Memory limit passed to `docker run --memory` for each sandbox container.
SANDBOX_MEMORY_LIMIT=256m

# CPU limit passed to `docker run --cpus` for each sandbox container.
SANDBOX_CPU_LIMIT=0.5

# Max think -> act -> observe iterations per message before giving up.
TOOL_USE_MAX_ITERATIONS=5

# Enables recording per-message/LLM-call/tool-call stats to a local SQLite
# database (data/stats.db, gitignored). Set to "false" to disable entirely.
STATS_ENABLED=true

# Path to the stats SQLite database.
STATS_DB_PATH=data/stats.db

# Whether prompt/reply text is stored alongside stats (useful for debugging,
# but is user-provided text). Set to "false" for privacy-sensitive deployments.
STATS_STORE_PROMPTS=true
